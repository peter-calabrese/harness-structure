{
  "name": "engineering-ai-platform",
  "version": "0.1.0",
  "description": "Canonical AI engineering harness: standards, agents, skills, provider adapters, policies, and distribution tooling.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "validate:skills": "node --experimental-strip-types tooling/validators/validate-skills.ts",
    "validate:agents": "node --experimental-strip-types tooling/validators/validate-agents.ts",
    "validate:standards": "node --experimental-strip-types tooling/validators/validate-standards.ts",
    "validate": "npm run validate:standards && npm run validate:agents && npm run validate:skills",
    "generate": "node --experimental-strip-types distribution/generate.ts",
    "sync": "node --experimental-strip-types distribution/sync.ts",
    "check-drift": "node --experimental-strip-types distribution/check-drift.ts",
    "test:policy": "node --test --experimental-strip-types tooling/policy-engine/tests/*.test.ts",
    "test:harness": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test": "npm run test:policy && npm run test:harness"
  }
}
